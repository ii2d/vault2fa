# ==============================================================================
# vault2fa - Deployment & Branding Configuration
# Customize these variables when deploying your own fork / GitHub Pages instance.
# ==============================================================================

# Short name of the application (e.g. "vault2fa", "my2fa")
VITE_APP_NAME="vault2fa"

# Main title of the application
VITE_APP_TITLE="Zero-Knowledge TOTP Authenticator"

# Subtitle / badge tagline
VITE_APP_SUBTITLE="Zero-Knowledge TOTP"

# Description for SEO meta tags and PWA manifest
VITE_APP_DESCRIPTION="Privacy-first, zero-knowledge, local-first 2FA/TOTP authenticator PWA"

# Source code / GitHub repository URL
VITE_APP_REPO_URL="https://github.com/ii2d/vault2fa"

# Canonical production URL (leave empty to auto-detect browser origin)
VITE_APP_URL=""

# PWA Theme Color (Hex)
VITE_APP_THEME_COLOR="#09090b"
