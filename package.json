{
  "name": "vault2fa",
  "private": true,
  "version": "0.3.0",
  "description": "Zero-knowledge, local-first 2FA/TOTP authenticator PWA built with Svelte 5 & Argon2id",
  "keywords": [
    "2fa",
    "totp",
    "authenticator",
    "zero-knowledge",
    "pwa",
    "svelte5",
    "webauthn",
    "argon2id",
    "local-first",
    "cryptography"
  ],
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pre-commit": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "pnpm audit --registry https://registry.npmjs.org/",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "sharp": "^0.35.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "hash-wasm": "^4.12.0",
    "otpauth": "^9.5.2",
    "tailwind-merge": "^3.7.0"
  }
}
